{
  "name": "fluxora",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered development orchestration desktop app",
  "scripts": {
    "dev": "pnpm --filter @fluxora/desktop tauri:dev",
    "dev:web": "pnpm --filter @fluxora/desktop dev",
    "build": "pnpm --filter @fluxora/desktop build",
    "tauri:dev": "pnpm --filter @fluxora/desktop tauri:dev",
    "tauri:build": "pnpm --filter @fluxora/desktop tauri:build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
